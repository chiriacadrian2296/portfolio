---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import type { Lang } from '../content';
import { contacts, experience, method, projectHref, projects, ui } from '../content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const featured = projects.find((p) => p.featured)!;
const others = projects.filter((p) => !p.featured);
---
<Base lang={lang} title={`Adrian Chiriac – ${ui.role[lang]}`} description={ui.intro[lang]} altPath={lang === 'it' ? 'en/' : ''}>
  <header class="hero">
    <h1>Adrian Chiriac</h1>
    <p class="role">{ui.role[lang]}</p>
    <p class="intro">{ui.intro[lang]}</p>
    <p class="loc muted"><i class="fa-solid fa-location-dot"></i> {ui.location[lang]}</p>
    <div class="actions">
      <a class="btn primary" href={`${base}${contacts.cv}`}><i class="fa-solid fa-file-arrow-down"></i>{ui.downloadCv[lang]}</a>
      <a class="btn" href={`mailto:${contacts.email}`}><i class="fa-solid fa-envelope"></i>{ui.writeMe[lang]}</a>
      <a class="btn" href={contacts.github}><i class="fa-brands fa-github"></i>GitHub</a>
      <a class="btn" href={contacts.linkedin}><i class="fa-brands fa-linkedin"></i>LinkedIn</a>
    </div>
  </header>

  <h2 id={lang === 'it' ? 'progetti' : 'projects'}><span class="ic"><i class="fa-solid fa-rocket"></i></span>{ui.projects[lang]}</h2>
  <a class="featured" href={`${base}${projectHref(lang, featured)}`}>
    <div class="f-text">
      <span class="badge">{ui.featured[lang]}</span>
      <h3>{featured.name}</h3>
      <p>{featured.tagline[lang]}</p>
      <div class="chips">{featured.stack.map((s) => <span class="chip">{s}</span>)}</div>
      <span class="more">{ui.readCase[lang]} <i class="fa-solid fa-arrow-right"></i></span>
    </div>
    {featured.cover && <Image class="f-img" src={featured.cover} alt={featured.name} width={360} densities={[1, 2]} />}
  </a>
  <div class="grid">
    {others.map((p) => (
      <a class="card" href={`${base}${projectHref(lang, p)}`}>
        <span class="ic"><i class={`fa-solid ${p.icon}`}></i></span>
        <h3>{p.name}</h3>
        <p>{p.tagline[lang]}</p>
        <div class="chips">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
        <span class="more">{ui.readCase[lang]} <i class="fa-solid fa-arrow-right"></i></span>
      </a>
    ))}
  </div>

  <h2><span class="ic"><i class="fa-solid fa-gears"></i></span>{ui.howIWork[lang]}</h2>
  <p class="lead">{ui.howIWorkLead[lang]}</p>
  <div class="method">
    {method.map((m) => (
      <div class="step">
        <span class="ic"><i class={`fa-solid ${m.icon}`}></i></span>
        <h3>{m.title[lang]}</h3>
        <p class="muted">{m.body[lang]}</p>
      </div>
    ))}
  </div>

  <h2><span class="ic"><i class="fa-solid fa-briefcase"></i></span>{ui.experience[lang]}</h2>
  <ol class="timeline">
    {experience.map((e) => (
      <li>
        <span class="when">{e.when}</span>
        <div>
          <h3>{e.title[lang]} <span class="org">· {e.org[lang]}</span></h3>
          <p class="muted">{e.body[lang]}</p>
        </div>
      </li>
    ))}
  </ol>

  <h2><span class="ic"><i class="fa-solid fa-envelope"></i></span>{ui.contact[lang]}</h2>
  <p class="lead">{ui.contactLead[lang]}</p>
  <ul class="contact">
    <li><i class="fa-solid fa-envelope"></i><a href={`mailto:${contacts.email}`}>{contacts.email}</a></li>
    <li><i class="fa-solid fa-phone"></i><a href={contacts.phoneHref}>{contacts.phone}</a></li>
    <li><i class="fa-brands fa-linkedin"></i><a href={contacts.linkedin}>LinkedIn</a></li>
    <li><i class="fa-brands fa-github"></i><a href={contacts.github}>GitHub</a></li>
  </ul>
</Base>

<style>
  .hero { padding: 56px 0 8px; }
  h1 { font-size: clamp(40px, 7vw, 68px); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
  .role { font-family: Rubik, sans-serif; font-size: 24px; color: var(--accent); font-weight: 500; margin-top: 6px; }
  .intro { max-width: 640px; margin-top: 20px; font-size: 19px; }
  .loc { margin-top: 10px; }
  .loc i { color: var(--accent); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }

  .featured {
    display: grid; grid-template-columns: 1fr 260px; gap: 32px; align-items: center;
    background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 32px; color: var(--text);
  }
  .featured:hover, .card:hover { text-decoration: none; border-color: var(--accent); }
  .badge { font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent); font-family: Rubik, sans-serif; }
  .featured h3 { font-size: 32px; margin: 6px 0 10px; }
  .featured p { margin-bottom: 16px; }
  .f-img { width: 100%; height: 340px; object-fit: cover; border-radius: 12px; }
  .more { display: inline-block; margin-top: 18px; color: var(--accent); font-family: Rubik, sans-serif; font-weight: 500; font-size: 15px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-top: 16px; }
  .card {
    display: flex; flex-direction: column; gap: 10px; color: var(--text);
    background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 24px;
  }
  .card h3 { font-size: 22px; }
  .card .more { margin-top: auto; padding-top: 6px; }

  .lead { max-width: 720px; margin-bottom: 24px; }
  .method { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .step { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 20px; }
  .step h3 { font-size: 18px; margin: 12px 0 6px; }
  .step p { font-size: 15px; }

  .timeline { list-style: none; border-left: 2px solid var(--line); margin-left: 6px; }
  .timeline li { display: grid; grid-template-columns: 130px 1fr; gap: 16px; padding: 0 0 22px 22px; position: relative; }
  .timeline li::before { content: ''; position: absolute; left: -7px; top: 8px; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); }
  .timeline h3 { font-size: 18px; }
  .timeline .org { color: var(--accent); font-weight: 500; }
  .when { color: var(--muted); font-family: Rubik, sans-serif; font-size: 15px; padding-top: 2px; }

  .contact { list-style: none; display: grid; gap: 10px; }
  .contact i { color: var(--accent); width: 22px; }

  @media (max-width: 760px) {
    .featured { grid-template-columns: 1fr; padding: 22px; }
    .f-img { height: 260px; }
    .timeline li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
